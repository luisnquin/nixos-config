-func TestFilesBucket(t *testing.T) {
-	tests := []struct {
-		files    int
-		expected string
-	}{
-		{0, "<100"},
-		{99, "<100"},
-		{100, "100-500"},
-		{499, "100-500"},
-		{500, "500-2.5k"},
-		{2499, "500-2.5k"},
-		{2500, "2.5k-10k"},
-		{9999, "2.5k-10k"},
-		{10000, "10k-50k"},
-		{49999, "10k-50k"},
-		{50000, "50k-100k"},
-		{99999, "50k-100k"},
-		{100000, ">100k"},
-		{500000, ">100k"},
-	}
-
-	for _, tt := range tests {
-		actual := filesBucket(tt.files)
-		if actual != tt.expected {
-			t.Errorf("filesBucket(%d) = %q, want %q", tt.files, actual, tt.expected)
-		}
-	}
-}
