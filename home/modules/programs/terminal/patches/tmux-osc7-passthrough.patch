diff --git a/src/shell-integration/zsh/ghostty-integration b/src/shell-integration/zsh/ghostty-integration
--- a/src/shell-integration/zsh/ghostty-integration
+++ b/src/shell-integration/zsh/ghostty-integration
@@ -245,10 +245,20 @@
     #   2. ${PWD//[[:cntrl:]]} removes raw control bytes (such as a real
     #      ESC or BEL) that may be part of the name. $HOST gets the same
     #      treatment. The title code below does the same thing.
-    _ghostty_report_pwd() {
-      builtin print -rnu $_ghostty_fd -- \
-        $'\e]7;kitty-shell-cwd://'"${HOST//[[:cntrl:]]}""${PWD//[[:cntrl:]]}"$'\a'
-    }
+    # Inside tmux the OSC 7 is consumed by tmux, so wrap it in tmux's
+    # passthrough envelope (doubled ESC) to reach the outer terminal.
+    # Requires `set -g allow-passthrough on`.
+    if [[ -n "$TMUX" ]]; then
+      _ghostty_report_pwd() {
+        builtin print -rnu $_ghostty_fd -- \
+          $'\ePtmux;\e\e]7;kitty-shell-cwd://'"${HOST//[[:cntrl:]]}""${PWD//[[:cntrl:]]}"$'\a\e\\'
+      }
+    else
+      _ghostty_report_pwd() {
+        builtin print -rnu $_ghostty_fd -- \
+          $'\e]7;kitty-shell-cwd://'"${HOST//[[:cntrl:]]}""${PWD//[[:cntrl:]]}"$'\a'
+      }
+    fi
     chpwd_functions=(${chpwd_functions[@]} "_ghostty_report_pwd")
     # An executed program could change cwd and report the changed cwd, so also report cwd at each new prompt
     # as in this case chpwd_functions is insufficient. chpwd_functions is still needed for things like: cd x && something
