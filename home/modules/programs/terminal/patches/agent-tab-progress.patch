+    /// Reflect terminal progress in the native tab chrome.
+    pub fn setProgressReport(
+        self: *Self,
+        value: terminal.osc.Command.ProgressReport,
+    ) void {
+        const page = self.getTabPage() orelse return;
+
+        page.setLoading(@intFromBool(switch (value.state) {
+            .set, .indeterminate => true,
+            .remove, .@"error", .pause => false,
+        }));
+
+        if (page.getSelected() == 0) switch (value.state) {
+            .@"error", .pause => page.setNeedsAttention(@intFromBool(true)),
+            .remove, .set, .indeterminate => {},
+        };
+    }
