+/// Trailing path components kept by the `current-dir` status line item.
+const STATUS_LINE_CWD_COMPONENTS: usize = 2;
+
+/// Renders the working directory as its last [`STATUS_LINE_CWD_COMPONENTS`]
+/// components, falling back to the full display path for shallower paths.
+fn format_status_line_cwd(directory: &Path) -> String {
+    let formatted = format_directory_display(directory, /*max_width*/ None);
+    let separator = std::path::MAIN_SEPARATOR.to_string();
+    let components: Vec<&str> = formatted.split(&separator).collect();
+    let Some(start) = components.len().checked_sub(STATUS_LINE_CWD_COMPONENTS) else {
+        return formatted;
+    };
+
+    components[start..].join(&separator)
+}
