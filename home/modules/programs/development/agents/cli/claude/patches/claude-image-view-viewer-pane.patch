@@ -63,6 +63,29 @@ export function fitRow(sizes: readonly (Size | null)[], maxRows: number, bodyCol
   return cells.slice(0, count)
 }
 
+export function fitBox(size: Size | null, columns: number, rows: number): Cells {
+  const { width, height } = size ?? FALLBACK
+  const wide = Math.round((rows * CELL_ASPECT * width) / height)
+  if (wide <= columns) return { columns: Math.max(1, wide), rows: Math.max(1, rows) }
+  return { columns: Math.max(1, columns), rows: Math.max(1, Math.round((columns * height) / (CELL_ASPECT * width))) }
+}
+
+export type Piece = { text: string } | { image: number; isSpaced: boolean }
+
+export function splitTags(text: string): Piece[][] {
+  return text.split('\n').map(line => {
+    const pieces: Piece[] = []
+    let before = ''
+    for (const part of line.split(/(\[Image #\d+\])/)) {
+      const tag = /^\[Image #(\d+)\]$/.exec(part)
+      if (tag) pieces.push({ image: Number(tag[1]), isSpaced: /\s$/.test(before) })
+      else for (const word of part.match(/\s*\S+/g) ?? []) pieces.push({ text: word })
+      before = part
+    }
+    return pieces
+  })
+}
+
 function rowWidth(cells: readonly Cells[], hidden: number): number {
   const tiles = cells.reduce((sum, c) => sum + c.columns + TILE_CHROME_COLUMNS, 0) + GAP * Math.max(0, cells.length - 1)
   return hidden > 0 ? tiles + GAP + `+${hidden}`.length : tiles
