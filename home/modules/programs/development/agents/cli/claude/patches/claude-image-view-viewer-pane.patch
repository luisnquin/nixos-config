+
+test('a message splits into words and tags, keeping the space before each tag', () => {
+  expect(splitTags('see [Image #1] and [Image #2]\n\n[Image #3]')).toEqual([
+    [{ text: 'see' }, { image: 1, isSpaced: true }, { text: ' and' }, { image: 2, isSpaced: true }],
+    [],
+    [{ image: 3, isSpaced: false }],
+  ])
+})
+
+test('the viewer keeps the aspect ratio in the room it has', () => {
+  expect(fitBox({ width: 1600, height: 800 }, 100, 20)).toEqual({ columns: 80, rows: 20 })
+  expect(fitBox({ width: 1600, height: 800 }, 40, 20)).toEqual({ columns: 40, rows: 10 })
+})
+
+const PANE = {
+  plugin: 'image-view',
+  component: 'Pane',
+  requestId: 'image-view',
+  viewport: { columns: 200, rows: 50 },
+} as const
+const paneProps = (isFocused: boolean) =>
+  ({ title: 'Image #1', isFocused, bodyColumns: 100, placement: 'dock', scroll: { offset: 0, bodyRows: 21 }, view: {} }) as const
+
+function pasted(on: On, draft: string) {
+  const dir = '/tmp/claude-501/-work/sess-1/images'
+  const entry = { size: 0, mtimeMs: 0, isLink: false }
+  on('session.start', () => ({ cwd: '/work' }))
+  on('prompt.read', () => ({ value: { text: draft, cursor: draft.length } }))
+  on('env.get', ($, e) => ({ value: GHOSTTY[e.name] }))
+  on('process.run', () => ran('501\n'))
+  on('session.id', () => ({ value: 'sess-1' }))
+  on('fs.list', () => ({ value: [{ name: '-work', kind: 'dir', ...entry }] }))
+  on('fs.exists', ($, e) => ({ value: e.path === dir || e.path === `${dir}/1.png` }))
+  on('fs.read', () => ({ value: { base64: pngHead(1600, 800) } }))
+  on('ui.render', () => ({ type: 'Text', props: {}, children: ['engine row'] }))
+  const opened: unknown[] = []
+  const closed: unknown[] = []
+  on('ui.open', ($, e) => {
+    opened.push(e)
+    return { value: { isPlaced: true } }
+  })
+  on('ui.close', ($, e) => {
+    closed.push(e)
+    return { value: undefined }
+  })
+  return { dir, opened, closed }
+}
+
+test('pressing a tile label opens the viewer, and pressing it again closes it', async ($, on) => {
+  const clock = mock.clock(on)
+  const { dir, opened, closed } = pasted(on, 'see [Image #1]')
+  await $.session.start({ surface: 'terminal', isInteractive: true, cwd: '/work' })
+  await clock.advance(200)
+
+  const band = await $.ui.mount({ ...BAND, surface: 'terminal' })
+  await band.press({ key: 'view-1' })
+  expect(opened).toEqual([expect.objectContaining({ id: 'image-view', title: 'Image #1', focus: true, closeOnEscape: true })])
+
+  const pane = await $.ui.mount({ ...PANE, surface: 'terminal', props: paneProps(false) })
+  expect((await pane.find({ type: 'Image' }))?.props).toMatchObject({ source: { file: `${dir}/1.png` }, columns: 80, rows: 20 })
+  await pane.unmount()
+
+  await band.press({ key: 'view-1' })
+  expect(closed).toEqual([expect.objectContaining({ id: 'image-view' })])
+})
+
+test('a tag in a sent message is a button that opens the viewer', async ($, on) => {
+  const clock = mock.clock(on)
+  const { opened } = pasted(on, '')
+  await $.session.start({ surface: 'terminal', isInteractive: true, cwd: '/work' })
+  await clock.advance(200)
+
+  const message = (text: string, isExpanded = true) =>
+    $.ui.mount({
+      plugin: 'image-view',
+      component: 'UserMessage',
+      requestId: 'row-1',
+      surface: 'terminal',
+      viewport: { columns: 120, rows: 40 },
+      props: { text, isExpanded, origin: { kind: 'prompt' } },
+    } as never)
+
+  const plain = await message('no pictures here')
+  expect(await plain.find({ type: 'Text', text: 'engine row' })).toBeDefined()
+  await plain.unmount()
+
+  const row = await message('look [Image #1] here')
+  expect(await row.find({ type: 'Text', text: ' here' })).toBeDefined()
+  await row.press({ key: 'tag-1-0' })
+  expect(opened).toEqual([expect.objectContaining({ id: 'image-view', title: 'Image #1' })])
+  await row.unmount()
+
+  const collapsed = await message('look [Image #1] here', false)
+  expect(await collapsed.find({ type: 'Text', text: 'engine row' })).toBeDefined()
+  expect(await collapsed.find({ key: 'tag-1' })).toBeDefined()
+})
+
+test('the viewer closes once it loses the keyboard it held', async ($, on) => {
+  const clock = mock.clock(on)
+  const { closed } = pasted(on, 'see [Image #1]')
+  await $.session.start({ surface: 'terminal', isInteractive: true, cwd: '/work' })
+  await clock.advance(200)
+  const band = await $.ui.mount({ ...BAND, surface: 'terminal' })
+  await band.press({ key: 'view-1' })
+
+  const focused = await $.ui.mount({ ...PANE, surface: 'terminal', props: paneProps(true) })
+  await focused.unmount()
+  expect(closed).toEqual([])
+  const blurred = await $.ui.mount({ ...PANE, surface: 'terminal', props: paneProps(false) })
+  await blurred.unmount()
+  await clock.advance(1)
+  expect(closed).toEqual([expect.objectContaining({ id: 'image-view' })])
+})
