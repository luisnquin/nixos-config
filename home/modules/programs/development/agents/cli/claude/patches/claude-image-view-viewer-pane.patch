+// Opened before any await: only an open the press is still behind counts as asked, and an
+// unasked pane is left undrawn below 144 columns.
+async function view($: EngineInterface, n: number) {
+  if (viewingN === n) {
+    await $.ui.close({ id: VIEWER })
+    return
+  }
+  viewingN = n
+  hadFocus = false
+  const opened = $.ui.open({ id: VIEWER, title: `Image #${n}`, focus: true, closeOnEscape: true })
+  const image = await describe($, await imagesDir($), n)
+  if (viewingN === n) await update($, viewing, () => image)
+  await opened
+}
