+
+  on('ui.close', { id: VIEWER }, async ($, e, next) => {
+    viewingN = undefined
+    await update($, viewing, () => null)
+    return next(e)
+  }).catch(($, e, next) => next(e))
+
+  on('ui.render', { component: 'Pane', requestId: VIEWER }, async ($, e, next) => {
+    if (e.surface !== 'terminal') return next(e)
+    const { Box, Image, Raster, Text } = $.ui.resolve(e)
+    const image = await read($, viewing)
+    if (image === null || image.path === null) return <Text dimColor>no preview</Text>
+
+    // Losing the keyboard is the closest a mod gets to a click outside the pane.
+    if (e.props.isFocused) hadFocus = true
+    else if (hadFocus) {
+      hadFocus = false
+      const shown = image.n
+      void $.clock.after(0, () => (viewingN === shown ? $.ui.close({ id: VIEWER }) : undefined))
+    }
+
+    const { columns, rows } = fitBox(image.size, e.props.bodyColumns, Math.max(1, e.props.scroll.bodyRows - 1))
+    const thumb = thumbs.get(image.path)
+    return (
+      <Box flexDirection="column" alignItems="center">
+        {thumb ? (
+          <Raster key={`viewer-blocks-${image.n}`} columns={columns} rows={rows} cells={blockCells(thumb, columns, rows)} />
+        ) : (
+          <Image
+            key={`viewer-${image.n}`}
+            source={{ file: image.path, format: 'png' }}
+            columns={columns}
+            rows={rows}
+            alt={`[Image #${image.n}]`}
+          />
+        )}
+        <Text dimColor wrap="truncate">{image.size ? `${image.size.width}×${image.size.height}` : ''}</Text>
+      </Box>
+    )
+  })
+
+  on('ui.render', { component: 'UserMessage' }, async ($, e, next) => {
+    if (e.surface !== 'terminal' || imageNumbers(e.props.text).length === 0) return next(e)
+    const { Box, Button, Text } = $.ui.resolve(e)
+    const press = (n: number) => () => void view($, n)
+
+    if (!e.props.isExpanded) {
+      const engine = await next(e)
+      return (
+        <Box flexDirection="column">
+          {engine}
+          <Box flexDirection="row" columnGap={1}>
+            {imageNumbers(e.props.text).map(n => (
+              <Button key={`tag-${n}`} plain dimColor onPress={press(n)}>{`[Image #${n}]`}</Button>
+            ))}
+          </Box>
+        </Box>
+      )
+    }
+
+    let count = 0
+    return (
+      <Box flexDirection="column">
+        {splitTags(e.props.text).map(line => (
+          <Box flexDirection="row" flexWrap="wrap">
+            {line.length === 0 && <Text> </Text>}
+            {line.map(piece =>
+              'text' in piece ? (
+                <Text>{piece.text}</Text>
+              ) : (
+                <Box marginLeft={piece.isSpaced ? 1 : 0}>
+                  <Button key={`tag-${piece.image}-${count++}`} plain onPress={press(piece.image)}>
+                    {`[Image #${piece.image}]`}
+                  </Button>
+                </Box>
+              ),
+            )}
+          </Box>
+        ))}
+      </Box>
+    )
+  })
 }
