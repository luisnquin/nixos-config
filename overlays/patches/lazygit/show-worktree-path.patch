+
+// worktreePathSubtitle is the path of the worktree lazygit is open on, shown in
+// the main panel's top right corner whenever that panel has no subtitle of its
+// own. The status panel only ever shows the repo name, which is the same for
+// every worktree of a repo and for identically named clones, so this is what
+// tells two lazygit instances apart.
+func (gui *Gui) worktreePathSubtitle() string {
+	if gui.git == nil {
+		return ""
+	}
+
+	return utils.ContractTilde(gui.git.RepoPaths.WorktreePath())
+}
diff --git a/pkg/utils/utils.go b/pkg/utils/utils.go
index 0494bb0..9083138 100644
--- a/pkg/utils/utils.go
+++ b/pkg/utils/utils.go
@@ -120,3 +120,31 @@ func ExpandTilde(path string) string {
 	}
 	return filepath.Join(home, path[2:])
 }
+
+// ContractTilde is the inverse of ExpandTilde: a path inside the current user's
+// home directory is shortened to "~/foo", and the home directory itself to "~".
+// Any other path, and any path if the home directory can't be determined, is
+// left untouched. Only for display: git is given the real path.
+func ContractTilde(path string) string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return path
+	}
+
+	// $HOME is whatever the environment says it is, trailing separator and all,
+	// while the paths we're shortening come from git and are already clean.
+	home = filepath.Clean(home)
+	if home == "." || home == string(filepath.Separator) {
+		return path
+	}
+
+	if path == home {
+		return "~"
+	}
+
+	prefix := home + string(filepath.Separator)
+	if !strings.HasPrefix(path, prefix) {
+		return path
+	}
+	return "~" + string(filepath.Separator) + path[len(prefix):]
+}
