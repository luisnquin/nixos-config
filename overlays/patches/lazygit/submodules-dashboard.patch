diff --git a/pkg/commands/models/submodule_status.go b/pkg/commands/models/submodule_status.go
new file mode 100644
index 000000000..d0e69fc3c
--- /dev/null
+++ b/pkg/commands/models/submodule_status.go
@@ -0,0 +1,78 @@
+package models
+
+// SubmoduleStatus is a submodule's state as read from its own repository rather
+// than from the superproject: the branch it has checked out, how far that branch
+// has diverged from its upstream, and whether its working tree is dirty. It's
+// what lets the submodules panel work as a dashboard over every repo the project
+// is made of, instead of having to enter each one to find out that it has commits
+// waiting to be pushed.
+type SubmoduleStatus struct {
+	// Cloned is false for a submodule that hasn't been initialised and updated
+	// yet: its directory is there, but there's no repository in it to read.
+	Cloned bool
+
+	// Branch is the checked-out branch, empty when HEAD is detached (which is
+	// the normal state for a submodule the superproject checked out itself).
+	Branch string
+	// Head is the hash HEAD points at, empty on an unborn branch.
+	Head string
+
+	// Upstream is the tracking branch, e.g. "origin/master". Empty when the
+	// checked-out branch has none, in which case Ahead and Behind are zero and
+	// mean nothing.
+	Upstream string
+	// Ahead and Behind count commits against the upstream *as last fetched*,
+	// i.e. what a push and a pull would carry right now. Same semantics as the
+	// branches panel's divergence, which is also read from the remote-tracking
+	// ref rather than from the remote.
+	Ahead  int
+	Behind int
+
+	// RecordedHead is the commit the parent module's index has for this
+	// submodule, i.e. the one a fresh clone of the parent would check out. It's
+	// empty when it couldn't be read.
+	RecordedHead string
+	// AheadOfRecorded and BehindRecorded count the commits between RecordedHead
+	// and Head, so that a submodule whose pointer the parent hasn't caught up
+	// with says by how much. Both are zero when the two agree, and also when
+	// they differ but the distance couldn't be measured (e.g. the recorded
+	// commit isn't in the submodule's object store).
+	AheadOfRecorded int
+	BehindRecorded  int
+
+	// Working tree counts, by the same categories `git status` reports:
+	// Untracked counts entries, so an untracked directory counts as one.
+	Staged     int
+	Unstaged   int
+	Untracked  int
+	Conflicted int
+
+	// LinesAdded and LinesDeleted total the uncommitted changes to tracked
+	// files, i.e. what `git diff HEAD --numstat` reports. Untracked files aren't
+	// in there, the same way the files panel's numstat leaves them out.
+	LinesAdded   int
+	LinesDeleted int
+}
+
+func (self *SubmoduleStatus) IsDetached() bool {
+	return self.Cloned && self.Branch == ""
+}
+
+func (self *SubmoduleStatus) HasUpstream() bool {
+	return self.Upstream != ""
+}
+
+func (self *SubmoduleStatus) IsDirty() bool {
+	return self.ChangeCount() > 0
+}
+
+func (self *SubmoduleStatus) ChangeCount() int {
+	return self.Staged + self.Unstaged + self.Untracked + self.Conflicted
+}
+
+// PointerDiffers reports whether the submodule is checked out at a different
+// commit than the parent module records for it, i.e. the parent needs a commit
+// of its own (or the submodule needs updating) for the two to agree.
+func (self *SubmoduleStatus) PointerDiffers() bool {
+	return self.Cloned && self.RecordedHead != "" && self.Head != "" && self.RecordedHead != self.Head
+}
