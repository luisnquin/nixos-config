diff --git a/pkg/commands/git_commands/submodule_loader.go b/pkg/commands/git_commands/submodule_loader.go
new file mode 100644
index 000000000..539f11659
--- /dev/null
+++ b/pkg/commands/git_commands/submodule_loader.go
@@ -0,0 +1,344 @@
+package git_commands
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/samber/lo"
+	"golang.org/x/sync/errgroup"
+)
+
+// Reading a submodule's status means one `git status` per submodule, so a
+// project with many of them would otherwise fork a process per submodule at
+// once on every refresh. They're independent repos, so they parallelise well;
+// this just keeps the burst bounded.
+const maxConcurrentSubmoduleStatusReads = 8
+
+type SubmoduleLoader struct {
+	*GitCommon
+}
+
+func NewSubmoduleLoader(gitCommon *GitCommon) *SubmoduleLoader {
+	return &SubmoduleLoader{GitCommon: gitCommon}
+}
+
+// LoadStatuses reads each submodule's own repository state, keyed by the
+// submodule's path relative to the superproject's worktree (i.e. FullPath, so
+// nested submodules get their whole path and don't collide with a same-named
+// submodule elsewhere in the tree).
+//
+// A submodule whose status can't be read is left out of the map rather than
+// given a zero status, so that the panel can tell "no repo state to show" from
+// "clean repo".
+func (self *SubmoduleLoader) LoadStatuses(configs []*models.SubmoduleConfig, background bool) map[string]*models.SubmoduleStatus {
+	statuses := make([]*models.SubmoduleStatus, len(configs))
+	var recordedHeads map[string]string
+
+	errg := errgroup.Group{}
+	errg.SetLimit(maxConcurrentSubmoduleStatusReads)
+	errg.Go(func() error {
+		recordedHeads = self.loadRecordedHeads(configs)
+		return nil
+	})
+	for i, config := range configs {
+		errg.Go(func() error {
+			status, err := self.loadStatus(config, background)
+			if err != nil {
+				// One unreadable submodule mustn't cost us the others' statuses.
+				self.Log.Errorf("failed to read status of submodule %s: %v", config.FullPath(), err)
+				return nil
+			}
+			statuses[i] = status
+			return nil
+		})
+	}
+	_ = errg.Wait()
+
+	result := make(map[string]*models.SubmoduleStatus, len(configs))
+	for i, config := range configs {
+		if statuses[i] == nil {
+			continue
+		}
+		statuses[i].RecordedHead = recordedHeads[config.FullPath()]
+		result[config.FullPath()] = statuses[i]
+	}
+
+	self.loadExtras(configs, result)
+
+	return result
+}
+
+// loadExtras fills in the parts of a status that need the status itself to know
+// whether they're worth reading: how far a submodule has drifted from the commit
+// its parent pins, and how many lines its uncommitted changes touch. Both are
+// skipped for the submodules they don't apply to, so a project whose submodules
+// are all clean and in step pays nothing for them.
+func (self *SubmoduleLoader) loadExtras(
+	configs []*models.SubmoduleConfig,
+	statuses map[string]*models.SubmoduleStatus,
+) {
+	errg := errgroup.Group{}
+	errg.SetLimit(maxConcurrentSubmoduleStatusReads)
+
+	for _, config := range configs {
+		status := statuses[config.FullPath()]
+		if status == nil {
+			continue
+		}
+
+		path := filepath.Join(self.repoPaths.WorktreePath(), config.FullPath())
+
+		if status.PointerDiffers() {
+			errg.Go(func() error {
+				status.BehindRecorded, status.AheadOfRecorded = self.distanceFromRecorded(path, status)
+				return nil
+			})
+		}
+
+		if status.Staged+status.Unstaged+status.Conflicted > 0 && status.Head != "" {
+			errg.Go(func() error {
+				status.LinesAdded, status.LinesDeleted = self.diffStat(path)
+				return nil
+			})
+		}
+	}
+
+	_ = errg.Wait()
+}
+
+// distanceFromRecorded measures the submodule's HEAD against the commit its
+// parent pins, so that a stale pointer says by how much it's stale.
+func (self *SubmoduleLoader) distanceFromRecorded(path string, status *models.SubmoduleStatus) (int, int) {
+	cmdArgs := NewGitCmd("rev-list").
+		Dir(path).
+		Arg("--count", "--left-right", status.RecordedHead+"..."+status.Head).
+		ToArgv()
+
+	output, err := forOtherRepo(self.cmd.New(cmdArgs)).DontLog().RunWithOutput()
+	if err != nil {
+		// Typically the pinned commit isn't in the submodule's object store (it
+		// was never fetched). We still know the two differ, we just can't say
+		// by how much.
+		self.Log.Errorf("failed to measure submodule %s against its pinned commit: %v", path, err)
+		return 0, 0
+	}
+
+	// The output is "<behind>\t<ahead>": the commits the pinned one has that
+	// HEAD lacks, then the ones HEAD has that it lacks.
+	fields := strings.Fields(output)
+	if len(fields) != 2 {
+		return 0, 0
+	}
+
+	behind, _ := strconv.Atoi(fields[0])
+	ahead, _ := strconv.Atoi(fields[1])
+
+	return behind, ahead
+}
+
+// diffStat totals the lines the submodule's uncommitted changes to tracked files
+// add and delete.
+func (self *SubmoduleLoader) diffStat(path string) (int, int) {
+	cmdArgs := NewGitCmd("diff").
+		Dir(path).
+		Arg("--numstat", "HEAD").
+		ToArgv()
+
+	output, err := forOtherRepo(self.cmd.New(cmdArgs)).DontLog().RunWithOutput()
+	if err != nil {
+		self.Log.Errorf("failed to read diff stat of submodule %s: %v", path, err)
+		return 0, 0
+	}
+
+	added, deleted := 0, 0
+	for line := range strings.SplitSeq(output, "\n") {
+		// Each line is "<added>\t<deleted>\t<path>", with "-" for both counts
+		// on a binary file.
+		fields := strings.Split(line, "\t")
+		if len(fields) < 3 {
+			continue
+		}
+		if value, err := strconv.Atoi(fields[0]); err == nil {
+			added += value
+		}
+		if value, err := strconv.Atoi(fields[1]); err == nil {
+			deleted += value
+		}
+	}
+
+	return added, deleted
+}
+
+// loadRecordedHeads reads the commit each submodule is pinned to in the index of
+// the module that contains it — which for a nested submodule is its parent
+// module, not the superproject — so the panel can tell that a submodule has
+// moved on from what the project records. One `git ls-files` per containing
+// module covers all of its submodules at once.
+func (self *SubmoduleLoader) loadRecordedHeads(configs []*models.SubmoduleConfig) map[string]string {
+	recordedHeads := map[string]string{}
+
+	byParent := lo.GroupBy(configs, func(config *models.SubmoduleConfig) *models.SubmoduleConfig {
+		return config.ParentModule
+	})
+
+	for parent, children := range byParent {
+		dir := self.repoPaths.WorktreePath()
+		if parent != nil {
+			dir = filepath.Join(dir, parent.FullPath())
+		}
+
+		// Paths are relative to the module whose index we're reading, so they
+		// are the plain Path rather than the FullPath.
+		paths := lo.Map(children, func(child *models.SubmoduleConfig, _ int) string {
+			return child.Path
+		})
+
+		cmdArgs := NewGitCmd("ls-files").
+			Dir(dir).
+			Arg("--stage", "-z", "--").
+			Arg(paths...).
+			ToArgv()
+
+		output, err := forOtherRepo(self.cmd.New(cmdArgs)).DontLog().RunWithOutput()
+		if err != nil {
+			self.Log.Errorf("failed to read recorded submodule commits in %s: %v", dir, err)
+			continue
+		}
+
+		fullPathsByPath := lo.SliceToMap(children, func(child *models.SubmoduleConfig) (string, string) {
+			return child.Path, child.FullPath()
+		})
+
+		// Each NUL-terminated entry looks like "<mode> <sha> <stage>\t<path>";
+		// gitlinks (mode 160000) are the submodule pointers we're after.
+		for entry := range strings.SplitSeq(output, "\x00") {
+			mode, rest, found := strings.Cut(entry, " ")
+			if !found || mode != "160000" {
+				continue
+			}
+			sha, rest, found := strings.Cut(rest, " ")
+			if !found {
+				continue
+			}
+			_, path, found := strings.Cut(rest, "\t")
+			if !found {
+				continue
+			}
+			if fullPath, ok := fullPathsByPath[path]; ok {
+				recordedHeads[fullPath] = sha
+			}
+		}
+	}
+
+	return recordedHeads
+}
+
+func (self *SubmoduleLoader) loadStatus(config *models.SubmoduleConfig, background bool) (*models.SubmoduleStatus, error) {
+	// Resolve against the repo this commands object was created for rather than
+	// the process working directory, so a read from a still-running refresh
+	// keeps addressing that repo after the user switched to another one; same
+	// reasoning as GetConfigs.
+	path := filepath.Join(self.repoPaths.WorktreePath(), config.FullPath())
+
+	if _, err := os.Stat(filepath.Join(path, ".git")); err != nil {
+		// The submodule hasn't been cloned into the worktree yet. Don't run git
+		// in there: with no repository of its own, it would climb up to the
+		// superproject and we'd report the parent's status as the child's.
+		return &models.SubmoduleStatus{Cloned: false}, nil
+	}
+
+	cmdArgs := NewGitCmd("status").
+		Dir(path).
+		Arg("--porcelain=v2", "--branch", "--untracked-files=normal").
+		ToArgv()
+
+	// forOtherRepo: GIT_DIR/GIT_WORK_TREE in the environment point at the
+	// superproject and would win over the -C above.
+	cmdObj := forOtherRepo(self.cmd.New(cmdArgs)).DontLog()
+	if !background {
+		// Same trade-off as the files refresh makes: a foreground refresh takes
+		// the optional lock so git persists its refreshed stat-cache (keeping
+		// later reads fast), a background one leaves it suppressed so it can't
+		// contend for the submodule's index.lock.
+		cmdObj.RemoveEnvVar(OptionalLocksEnvVar)
+	}
+
+	output, err := cmdObj.RunWithOutput()
+	if err != nil {
+		return nil, err
+	}
+
+	return parseSubmoduleStatus(output), nil
+}
+
+// parseSubmoduleStatus reads `git status --porcelain=v2 --branch` output, whose
+// header lines carry the branch and its divergence from its upstream, and whose
+// entry lines each describe one changed path:
+//
+//	# branch.head <branch>|(detached)
+//	# branch.upstream <upstream>
+//	# branch.ab +<ahead> -<behind>
+//	1 <XY> ...         ordinary change
+//	2 <XY> ...         rename/copy
+//	u <XY> ...         unmerged
+//	? <path>           untracked
+//
+// In <XY>, X is the change staged in the index and Y the one in the worktree,
+// with '.' meaning unchanged, so a path can count as both staged and unstaged.
+func parseSubmoduleStatus(output string) *models.SubmoduleStatus {
+	status := &models.SubmoduleStatus{Cloned: true}
+
+	for line := range strings.SplitSeq(strings.ReplaceAll(output, "\r\n", "\n"), "\n") {
+		switch {
+		case strings.HasPrefix(line, "# branch.oid "):
+			if oid := strings.TrimPrefix(line, "# branch.oid "); oid != "(initial)" {
+				status.Head = oid
+			}
+		case strings.HasPrefix(line, "# branch.head "):
+			if head := strings.TrimPrefix(line, "# branch.head "); head != "(detached)" {
+				status.Branch = head
+			}
+		case strings.HasPrefix(line, "# branch.upstream "):
+			status.Upstream = strings.TrimPrefix(line, "# branch.upstream ")
+		case strings.HasPrefix(line, "# branch.ab "):
+			status.Ahead, status.Behind = parseAheadBehind(strings.TrimPrefix(line, "# branch.ab "))
+		case strings.HasPrefix(line, "1 "), strings.HasPrefix(line, "2 "):
+			fields := strings.Fields(line)
+			if len(fields) < 2 || len(fields[1]) < 2 {
+				continue
+			}
+			if fields[1][0] != '.' {
+				status.Staged++
+			}
+			if fields[1][1] != '.' {
+				status.Unstaged++
+			}
+		case strings.HasPrefix(line, "u "):
+			status.Conflicted++
+		case strings.HasPrefix(line, "? "):
+			status.Untracked++
+		}
+	}
+
+	return status
+}
+
+// parseAheadBehind parses the "+<ahead> -<behind>" value of the branch.ab
+// header. Both counts are relative to the remote-tracking ref as last fetched.
+func parseAheadBehind(field string) (int, int) {
+	values := strings.Fields(field)
+	if len(values) != 2 {
+		return 0, 0
+	}
+
+	ahead, err1 := strconv.Atoi(strings.TrimPrefix(values[0], "+"))
+	behind, err2 := strconv.Atoi(strings.TrimPrefix(values[1], "-"))
+	if err1 != nil || err2 != nil {
+		return 0, 0
+	}
+
+	return ahead, behind
+}
