@@ -0,0 +1,107 @@
+package git_commands
+
+import (
+	"testing"
+
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestParseSubmoduleStatus(t *testing.T) {
+	scenarios := []struct {
+		testName string
+		output   string
+		expected *models.SubmoduleStatus
+	}{
+		{
+			testName: "clean branch in sync with its upstream",
+			output: `# branch.oid ce59834e0306b1317c42cc9ca987a8e5100b133c
+# branch.head master
+# branch.upstream origin/master
+# branch.ab +0 -0
+`,
+			expected: &models.SubmoduleStatus{
+				Cloned:   true,
+				Head:     "ce59834e0306b1317c42cc9ca987a8e5100b133c",
+				Branch:   "master",
+				Upstream: "origin/master",
+			},
+		},
+		{
+			testName: "commits pending in both directions",
+			output: `# branch.oid ce59834e0306b1317c42cc9ca987a8e5100b133c
+# branch.head master
+# branch.upstream origin/master
+# branch.ab +2 -3
+`,
+			expected: &models.SubmoduleStatus{
+				Cloned:   true,
+				Head:     "ce59834e0306b1317c42cc9ca987a8e5100b133c",
+				Branch:   "master",
+				Upstream: "origin/master",
+				Ahead:    2,
+				Behind:   3,
+			},
+		},
+		{
+			testName: "a path changed in both the index and the worktree counts as both",
+			output: `# branch.oid ce59834e0306b1317c42cc9ca987a8e5100b133c
+# branch.head master
+# branch.upstream origin/master
+# branch.ab +1 -0
+1 .M N... 100644 100644 100644 7898192 7898192 a.txt
+1 A. N... 000000 100644 100644 0000000 19d9cc8 s.txt
+2 R. N... 100644 100644 100644 7898192 7898192 R100 new.txt	old.txt
+u UU N... 100644 100644 100644 100644 7898192 7898192 7898192 conflicted.txt
+? u.txt
+`,
+			expected: &models.SubmoduleStatus{
+				Cloned:     true,
+				Head:       "ce59834e0306b1317c42cc9ca987a8e5100b133c",
+				Branch:     "master",
+				Upstream:   "origin/master",
+				Ahead:      1,
+				Staged:     2,
+				Unstaged:   1,
+				Untracked:  1,
+				Conflicted: 1,
+			},
+		},
+		{
+			testName: "detached head, which is how a submodule is normally checked out",
+			output: `# branch.oid 9182dcd32e578d8c7f300a0b820fa3d077b84222
+# branch.head (detached)
+`,
+			expected: &models.SubmoduleStatus{
+				Cloned: true,
+				Head:   "9182dcd32e578d8c7f300a0b820fa3d077b84222",
+			},
+		},
+		{
+			testName: "unborn branch, before the first commit",
+			output: `# branch.oid (initial)
+# branch.head master
+`,
+			expected: &models.SubmoduleStatus{
+				Cloned: true,
+				Branch: "master",
+			},
+		},
+		{
+			testName: "crlf line endings",
+			output:   "# branch.oid ce59834\r\n# branch.head master\r\n? u.txt\r\n",
+			expected: &models.SubmoduleStatus{
+				Cloned:    true,
+				Head:      "ce59834",
+				Branch:    "master",
+				Untracked: 1,
+			},
+		},
+	}
+
+	for _, s := range scenarios {
+		t.Run(s.testName, func(t *testing.T) {
+			assert.Equal(t, s.expected, parseSubmoduleStatus(s.output))
+		})
+	}
+}
