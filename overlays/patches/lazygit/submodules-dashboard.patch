diff --git a/pkg/integration/tests/submodule/status.go b/pkg/integration/tests/submodule/status.go
new file mode 100644
index 000000000..45c44cb39
--- /dev/null
+++ b/pkg/integration/tests/submodule/status.go
@@ -0,0 +1,43 @@
+package submodule
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/config"
+	. "github.com/jesseduffield/lazygit/pkg/integration/components"
+)
+
+var Status = NewIntegrationTest(NewIntegrationTestArgs{
+	Description:  "Show a submodule's own branch, divergence from its upstream, and dirty state without entering it",
+	ExtraCmdArgs: []string{},
+	Skip:         false,
+	SetupConfig:  func(cfg *config.AppConfig) {},
+	SetupRepo: func(shell *Shell) {
+		shell.EmptyCommit("first commit")
+		shell.CloneIntoSubmodule("my_submodule_name", "my_submodule_path")
+		shell.GitAddAll()
+		shell.Commit("add submodule")
+
+		shell.Chdir("my_submodule_path")
+		shell.EmptyCommit("commit waiting to be pushed")
+		shell.CreateFile("untracked_file", "untracked")
+		shell.Chdir("..")
+	},
+	Run: func(t *TestDriver, keys config.KeybindingConfig) {
+		t.Views().Submodules().Focus().
+			Lines(
+				Contains("└─ my_submodule_name").
+					Contains("master").
+					Contains("↑1").
+					Contains("*1").
+					Contains("⇡1").
+					IsSelected(),
+			)
+
+		t.Views().Main().
+			Content(Contains("Branch:      master")).
+			Content(Contains("Upstream:    origin/master")).
+			Content(Contains("Divergence:  ↓0 ↑1")).
+			Content(Contains("Worktree:    1 untracked")).
+			Content(Contains("Parent:      ")).
+			Content(Contains("differs from HEAD (↓0 ↑1)"))
+	},
+})
diff --git a/pkg/integration/tests/submodule/status_nested.go b/pkg/integration/tests/submodule/status_nested.go
new file mode 100644
index 000000000..01ba31463
--- /dev/null
+++ b/pkg/integration/tests/submodule/status_nested.go
@@ -0,0 +1,52 @@
+package submodule
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/config"
+	. "github.com/jesseduffield/lazygit/pkg/integration/components"
+)
+
+var StatusNested = NewIntegrationTest(NewIntegrationTestArgs{
+	Description:  "Show nested submodules as a tree, with the description from .gitmodules",
+	ExtraCmdArgs: []string{},
+	Skip:         false,
+	SetupConfig:  func(cfg *config.AppConfig) {},
+	SetupRepo: func(shell *Shell) {
+		setupNestedSubmodules(shell)
+
+		shell.Chdir("..")
+		shell.CreateDir("secondSubmodule")
+		shell.Chdir("secondSubmodule")
+		shell.Init()
+		shell.CreateFileAndAdd("second", "second")
+		shell.Commit("initial second commit")
+
+		shell.Chdir("../repo")
+		shell.RunCommand([]string{"git", "-c", "protocol.file.allow=always", "submodule", "add", "--name", "secondSubName", "../secondSubmodule", "modules/secondSubPath"})
+		// `description` isn't a key git knows about; it's ours to render.
+		shell.RunCommand([]string{"git", "config", "-f", ".gitmodules", "submodule.outerSubName.description", "The outer one"})
+		shell.Commit("add dependency as secondSubmodule")
+	},
+	Run: func(t *TestDriver, keys config.KeybindingConfig) {
+		t.Views().Submodules().Focus().
+			Lines(
+				Contains("├─ outerSubName").IsSelected(),
+				Contains("│  └─ innerSubName"),
+				Contains("└─ secondSubName"),
+			).
+			Tap(func() {
+				t.Views().Main().
+					Content(Contains("Name:        outerSubName")).
+					Content(Contains("Description: The outer one"))
+			}).
+			SelectNextItem().
+			Tap(func() {
+				t.Views().Main().
+					Content(Contains("Name:        outerSubName/innerSubName")).
+					// a submodule checked out by its parent sits on a detached HEAD
+					Content(Contains("Branch:      detached at")).
+					Content(Contains("Upstream:    none")).
+					// nothing sets a description for this one
+					Content(DoesNotContain("Description:"))
+			})
+	},
+})
