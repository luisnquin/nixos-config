+// submoduleField renders one line of the submodule summary, with the labels
+// wide enough for the longest of them so the values line up in a column.
+func submoduleField(label string, value string) string {
+	return fmt.Sprintf("%-12s %s\n", label+":", value)
+}
+
+// descriptionField renders the non-standard `description` key from .gitmodules,
+// which git ignores but projects use to say what a submodule is for. Most
+// repos don't set it, so the line is omitted entirely rather than left blank.
+func descriptionField(submodule *models.SubmoduleConfig, tr *i18n.TranslationSet) string {
+	if submodule.Summary == "" {
+		return ""
+	}
+
+	return submoduleField(tr.SubmoduleStatusDescription, submodule.Summary)
+}
+
+// statusSummary describes the submodule's own repo state, so that the panel
+// answers "what shape is this repo in" without having to enter it. It's empty
+// when the status isn't loaded: either they're turned off, or this is the first
+// refresh and they haven't landed yet.
+func (self *SubmodulesController) statusSummary(submodule *models.SubmoduleConfig) string {
+	status := self.c.Model().SubmoduleStatuses[submodule.FullPath()]
+	if status == nil {
+		return ""
+	}
+
+	tr := self.c.Tr
+
+	if !status.Cloned {
+		return "\n" + submoduleField(tr.SubmoduleStatusBranch, style.FgRed.Sprint(tr.SubmoduleNotCloned))
+	}
+
+	branch := style.FgCyan.Sprint(status.Branch)
+	if status.IsDetached() {
+		branch = style.FgYellow.Sprint(utils.ResolvePlaceholderString(
+			tr.SubmoduleDetachedAt,
+			map[string]string{"hash": utils.ShortHash(status.Head)},
+		))
+	}
+
+	summary := "\n" + submoduleField(tr.SubmoduleStatusBranch, branch)
+
+	if status.HasUpstream() {
+		divergence := style.FgGreen.Sprint(tr.SubmoduleStatusInSync)
+		if status.Ahead > 0 || status.Behind > 0 {
+			divergence = style.FgYellow.Sprintf("↓%d ↑%d", status.Behind, status.Ahead)
+		}
+		summary += submoduleField(tr.SubmoduleStatusUpstream, style.FgCyan.Sprint(status.Upstream))
+		summary += submoduleField(tr.SubmoduleStatusDivergence, divergence)
+	} else {
+		summary += submoduleField(tr.SubmoduleStatusUpstream, style.FgRed.Sprint(tr.SubmoduleStatusNoUpstream))
+	}
+
+	summary += submoduleField(tr.SubmoduleStatusWorkingTree, worktreeSummary(status, tr))
+
+	return summary + submoduleField(tr.SubmoduleStatusParent, parentSummary(status, tr))
+}
+
+// parentSummary describes the commit the parent module pins this submodule to.
+// When it isn't the commit that's checked out here, the parent needs a commit
+// of its own before anyone else gets what we're looking at.
+func parentSummary(status *models.SubmoduleStatus, tr *i18n.TranslationSet) string {
+	if status.RecordedHead == "" {
+		return style.FgRed.Sprint(tr.SubmoduleStatusNoUpstream)
+	}
+
+	hash := style.FgYellow.Sprint(utils.ShortHash(status.RecordedHead))
+
+	if !status.PointerDiffers() {
+		return fmt.Sprintf("%s %s", hash, style.FgGreen.Sprint(tr.SubmoduleStatusParentMatches))
+	}
+
+	distance := ""
+	if status.AheadOfRecorded > 0 || status.BehindRecorded > 0 {
+		distance = fmt.Sprintf(" (↓%d ↑%d)", status.BehindRecorded, status.AheadOfRecorded)
+	}
+
+	return fmt.Sprintf("%s %s", hash, style.FgMagenta.Sprint(tr.SubmoduleStatusParentDiffers+distance))
+}
+
+// worktreeSummary spells out the counts the list view compresses into a single
+// number, e.g. "2 unstaged, 1 untracked".
+func worktreeSummary(status *models.SubmoduleStatus, tr *i18n.TranslationSet) string {
+	if !status.IsDirty() {
+		return style.FgGreen.Sprint(tr.SubmoduleStatusClean)
+	}
+
+	parts := []string{}
+	for _, part := range []struct {
+		count int
+		label string
+	}{
+		{status.Conflicted, tr.SubmoduleStatusConflicted},
+		{status.Staged, tr.SubmoduleStatusStaged},
+		{status.Unstaged, tr.SubmoduleStatusUnstaged},
+		{status.Untracked, tr.SubmoduleStatusUntracked},
+	} {
+		if part.count > 0 {
+			parts = append(parts, fmt.Sprintf("%d %s", part.count, part.label))
+		}
+	}
+
+	summary := style.FgRed.Sprint(strings.Join(parts, ", "))
+
+	if status.LinesAdded > 0 || status.LinesDeleted > 0 {
+		summary += fmt.Sprintf(" (%s %s)",
+			style.FgGreen.Sprintf("+%d", status.LinesAdded),
+			style.FgRed.Sprintf("-%d", status.LinesDeleted),
+		)
+	}
+
+	return summary
+}
+
 func (self *SubmodulesController) enter(submodule *models.SubmoduleConfig) error {
 	return self.c.Helpers().Repos.EnterSubmodule(submodule)
 }
