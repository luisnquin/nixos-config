@@ -0,0 +1,74 @@
+package presentation
+
+import (
+	"testing"
+
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestSubmoduleTreePrefixes(t *testing.T) {
+	// Submodules arrive depth-first: a submodule is always followed by its own
+	// children, so the tree only needs to know who each one's parent is.
+	sub := func(name string, parent *models.SubmoduleConfig) *models.SubmoduleConfig {
+		return &models.SubmoduleConfig{Name: name, Path: name, ParentModule: parent}
+	}
+
+	scenarios := []struct {
+		testName string
+		build    func() []*models.SubmoduleConfig
+		expected []string
+	}{
+		{
+			testName: "no submodules",
+			build:    func() []*models.SubmoduleConfig { return nil },
+			expected: []string{},
+		},
+		{
+			testName: "flat list",
+			build: func() []*models.SubmoduleConfig {
+				return []*models.SubmoduleConfig{sub("a", nil), sub("b", nil), sub("c", nil)}
+			},
+			expected: []string{"├─ ", "├─ ", "└─ "},
+		},
+		{
+			testName: "children of a non-last submodule carry its line down",
+			build: func() []*models.SubmoduleConfig {
+				a := sub("a", nil)
+				return []*models.SubmoduleConfig{a, sub("a1", a), sub("a2", a), sub("b", nil)}
+			},
+			expected: []string{"├─ ", "│  ├─ ", "│  └─ ", "└─ "},
+		},
+		{
+			testName: "children of the last submodule don't",
+			build: func() []*models.SubmoduleConfig {
+				b := sub("b", nil)
+				return []*models.SubmoduleConfig{sub("a", nil), b, sub("b1", b)}
+			},
+			expected: []string{"├─ ", "└─ ", "   └─ "},
+		},
+		{
+			testName: "grandchildren",
+			build: func() []*models.SubmoduleConfig {
+				a := sub("a", nil)
+				a1 := sub("a1", a)
+				return []*models.SubmoduleConfig{a, a1, sub("a1a", a1), sub("a2", a)}
+			},
+			expected: []string{"└─ ", "   ├─ ", "   │  └─ ", "   └─ "},
+		},
+		{
+			testName: "a submodule whose parent was filtered out is a root",
+			build: func() []*models.SubmoduleConfig {
+				missing := sub("missing", nil)
+				return []*models.SubmoduleConfig{sub("a", nil), sub("orphan", missing)}
+			},
+			expected: []string{"├─ ", "└─ "},
+		},
+	}
+
+	for _, s := range scenarios {
+		t.Run(s.testName, func(t *testing.T) {
+			assert.Equal(t, s.expected, submoduleTreePrefixes(s.build()))
+		})
+	}
+}
