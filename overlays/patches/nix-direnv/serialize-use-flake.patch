--- a/direnvrc
+++ b/direnvrc
@@ -273,7 +273,7 @@
   fi
 }
 
-use_flake() {
+_nix_direnv_use_flake() {
   if ! _nix_direnv_preflight; then
     return 1
   fi
@@ -393,7 +393,43 @@
     fi
   fi
 
-  _nix_import_env "$profile_rc"
+  _nix_direnv_profile_rc="$profile_rc"
+}
+
+use_flake() {
+  local layout_dir lock_fd status
+  layout_dir=$(direnv_layout_dir)
+
+  if ! mkdir -p "$layout_dir"; then
+    _nix_direnv_error "could not create cache directory: $layout_dir"
+    return 1
+  fi
+
+  if ! exec {lock_fd}>"${layout_dir}/.nix-direnv-use-flake.lock"; then
+    _nix_direnv_error "could not open use_flake cache lock"
+    return 1
+  fi
+
+  # lock_fd has no close-on-exec, so a daemon started under the lock keeps it
+  # held after every shell in its ancestry is gone. Never block forever on it.
+  if ! flock -w 120 "$lock_fd"; then
+    _nix_direnv_warning "use_flake cache lock timed out, refreshing unserialized"
+  fi
+
+  status=0
+  _nix_direnv_profile_rc=
+  _nix_direnv_use_flake "$@" || status=$?
+
+  exec {lock_fd}>&-
+
+  # Outside the lock on purpose: this evaluates the devShell rc, running the
+  # flake's shellHook, and any daemon it spawns would inherit lock_fd.
+  if [[ $status -eq 0 ]]; then
+    _nix_import_env "$_nix_direnv_profile_rc" || status=$?
+  fi
+
+  unset _nix_direnv_profile_rc
+  return "$status"
 }
 
 use_nix() {
