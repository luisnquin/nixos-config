+// refitImages re-renders the details pane after a resize so image placements
+// match the new column budget. Runs after every draw, so it must stay cheap
+// and must not touch the UI outside of a queued update.
+func (a *App) refitImages() {
+	if !a.images.hasSupport() || a.detailsDescriptionView == nil {
+		return
+	}
+	width := bodyWidth(a.detailsDescriptionView)
+	if width == a.detailsImageWidth {
+		return
