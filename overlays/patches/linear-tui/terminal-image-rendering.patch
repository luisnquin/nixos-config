diff --git a/internal/tui/kitty_images.go b/internal/tui/kitty_images.go
new file mode 100644
index 0000000..d966d1a
--- /dev/null
+++ b/internal/tui/kitty_images.go
@@ -0,0 +1,658 @@
+package tui
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"image"
+	"image/color"
+	_ "image/gif"
+	_ "image/jpeg"
+	"image/png"
+	"io"
+	"mime"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/roeyazroel/linear-tui/internal/config"
+	"github.com/roeyazroel/linear-tui/internal/logger"
+)
+
+const (
+	// imagePlaceholderRune is the Kitty graphics protocol Unicode placeholder.
+	// A cell holding it renders the slice of the image identified by the cell
+	// foreground color, at the row/column encoded in its combining diacritics.
+	imagePlaceholderRune = '\U0010EEEE'
+
+	imageMaxCellRows     = 20
+	imageMaxCellCols     = 100
+	imageFetchTimeout    = 30 * time.Second
+	imageMaxDownloadSize = 16 << 20
+	imageCacheEntries    = 24
+	imageChunkSize       = 4096
+	tmuxQueryTimeout     = 2 * time.Second
+
+	// Fallback cell geometry for terminals that do not report pixel sizes.
+	defaultCellPixelWidth  = 9
+	defaultCellPixelHeight = 18
+)
+
+type imageLoadState int
+
+const (
+	imageLoading imageLoadState = iota
+	imageReady
+	imageFailed
+)
+
+// kittyImage is one remote image tracked for the lifetime of the session.
+type kittyImage struct {
+	id     uint32
+	state  imageLoadState
+	err    error
+	src    image.Image
+	cols   int
+	rows   int
+	placed bool
+	seq    int64
+}
+
+// imageRenderer downloads images referenced from markdown and hands the
+// terminal Kitty graphics placements for them. Placements are virtual: the
+// terminal only paints an image where placeholder cells are drawn, so tview
+// keeps full control of scrolling and clipping.
+type imageRenderer struct {
+	mu      sync.Mutex
+	enabled bool
+	out     io.Writer
+	client  *http.Client
+	token   string
+	bearer  bool
+	tmux    bool
+	images  map[string]*kittyImage
+	nextID  uint32
+	seq     int64
+	notify  func()
+}
+
+func newImageRenderer(cfg config.Config, notify func()) *imageRenderer {
+	r := &imageRenderer{
+		enabled: kittyGraphicsEnabled(),
+		out:     os.Stdout,
+		token:   cfg.LinearAPIKey,
+		bearer:  cfg.UseBearer,
+		tmux:    insideTmux(),
+		images:  make(map[string]*kittyImage),
+		nextID:  1,
+		notify:  notify,
+	}
+	r.client = &http.Client{
+		Timeout: imageFetchTimeout,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if len(via) >= 5 {
+				return errors.New("too many redirects")
+			}
+			// Linear redirects uploads to pre-signed storage URLs; the API
+			// token must not travel to whatever host that turns out to be.
+			if req.URL.Host != via[0].URL.Host {
+				req.Header.Del("Authorization")
+			}
+			return nil
+		},
+	}
+	return r
+}
+
+// kittyGraphicsEnabled reports whether images should be drawn at all.
+// LINEAR_IMAGES overrides the terminal sniffing in both directions.
+func kittyGraphicsEnabled() bool {
+	switch strings.ToLower(strings.TrimSpace(os.Getenv(config.ImagesEnv))) {
+	case "0", "false", "off", "never":
+		return false
+	case "1", "true", "on", "always":
+		return isTerminalWriter(os.Stdout)
+	}
+
+	if !isTerminalWriter(os.Stdout) {
+		return false
+	}
+	// Inside tmux the graphics escapes only reach the terminal through DCS
+	// passthrough, and without it every image would come out as a block of
+	// empty cells. Links read better than that.
+	if insideTmux() && !tmuxPassthroughEnabled() {
+		logger.Warning("tui.images: disabled, tmux needs `set -g allow-passthrough on`")
+		return false
+	}
+	if os.Getenv("KITTY_WINDOW_ID") != "" || os.Getenv("GHOSTTY_RESOURCES_DIR") != "" {
+		return true
+	}
+	term := strings.ToLower(os.Getenv("TERM"))
+	if strings.Contains(term, "kitty") || strings.Contains(term, "ghostty") {
+		return true
+	}
+	switch strings.ToLower(os.Getenv("TERM_PROGRAM")) {
+	case "ghostty", "kitty":
+		return true
+	}
+	return false
+}
+
+func isTerminalWriter(f *os.File) bool {
+	info, err := f.Stat()
+	if err != nil {
+		return false
+	}
+	return info.Mode()&os.ModeCharDevice != 0
+}
+
+func insideTmux() bool {
+	return os.Getenv("TMUX") != ""
+}
+
+// tmuxPassthroughEnabled asks the running server whether it forwards escape
+// sequences it does not understand.
+func tmuxPassthroughEnabled() bool {
+	ctx, cancel := context.WithTimeout(context.Background(), tmuxQueryTimeout)
+	defer cancel()
+
+	out, err := exec.CommandContext(ctx, "tmux", "show", "-gv", "allow-passthrough").Output()
+	if err != nil {
+		logger.Warning("tui.images: tmux allow-passthrough query failed error=%v", err)
+		return false
+	}
+	return strings.TrimSpace(string(out)) == "on"
+}
+
+// markdownSegment is either a run of markdown text or a single image link.
+type markdownSegment struct {
+	text  string
+	url   string
+	alt   string
+	image bool
+}
+
+var markdownImagePattern = regexp.MustCompile(`!\[([^\]]*)\]\(\s*<?([^)>\s]+)>?(?:\s+"[^"]*"|\s+'[^']*')?\s*\)`)
+
+// splitMarkdownImages cuts content at every markdown image link, keeping the
+// surrounding text in document order.
+func splitMarkdownImages(content string) []markdownSegment {
+	matches := markdownImagePattern.FindAllStringSubmatchIndex(content, -1)
+	if len(matches) == 0 {
+		return []markdownSegment{{text: content}}
+	}
+
+	segments := make([]markdownSegment, 0, len(matches)*2+1)
+	last := 0
+	for _, m := range matches {
+		if m[0] > last {
+			segments = append(segments, markdownSegment{text: content[last:m[0]]})
+		}
+		segments = append(segments, markdownSegment{
+			alt:   content[m[2]:m[3]],
+			url:   content[m[4]:m[5]],
+			image: true,
+		})
+		last = m[1]
+	}
+	if last < len(content) {
+		segments = append(segments, markdownSegment{text: content[last:]})
+	}
+	return segments
+}
+
+// render returns the tview markup that displays imageURL, starting the
+// download on first use. Callers must run on the UI goroutine: a ready image
+// is handed to the terminal from here.
+func (r *imageRenderer) render(imageURL, alt string, maxCols int) string {
+	if r == nil || !r.enabled {
+		return ""
+	}
+
+	entry, fresh := r.entry(imageURL)
+	if fresh {
+		go r.fetch(imageURL, entry)
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	switch entry.state {
+	case imageLoading:
+		return placeholderNotice("loading image…", alt)
+	case imageFailed:
+		return placeholderNotice(fmt.Sprintf("image unavailable (%v)", entry.err), alt)
+	}
+
+	block, err := r.placeLocked(entry, imageURL, maxCols)
+	if err != nil {
+		return placeholderNotice(fmt.Sprintf("image unavailable (%v)", err), alt)
+	}
+	return block
+}
+
+// renderAttachment returns the markup that displays an issue attachment, or an
+// empty string while it is still loading and for anything that turns out not
+// to be an image. Most attachments are plain links, so failures stay silent
+// here instead of printing a notice under every one of them.
+func (r *imageRenderer) renderAttachment(attachmentURL string, maxCols int) string {
+	if r == nil || !r.enabled || !attachmentIsRenderable(attachmentURL) {
+		return ""
+	}
+
+	entry, fresh := r.entry(attachmentURL)
+	if fresh {
+		go r.fetch(attachmentURL, entry)
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	if entry.state != imageReady {
+		return ""
+	}
+	block, err := r.placeLocked(entry, attachmentURL, maxCols)
+	if err != nil {
+		return ""
+	}
+	return block
+}
+
+// placeLocked hands the terminal the placement for a decoded image and returns
+// the cells that display it. r.mu must be held.
+func (r *imageRenderer) placeLocked(entry *kittyImage, imageURL string, maxCols int) (string, error) {
+	cols, rows := placementSize(entry.src.Bounds().Dx(), entry.src.Bounds().Dy(), maxCols)
+	if cols <= 0 || rows <= 0 {
+		return "", errors.New("image too small to display")
+	}
+
+	if !entry.placed || entry.cols != cols || entry.rows != rows {
+		entry.cols, entry.rows = cols, rows
+		if err := r.transmit(entry); err != nil {
+			entry.state = imageFailed
+			entry.err = err
+			entry.placed = false
+			logger.Warning("tui.images: transmit failed url=%s error=%v", imageURL, err)
+			return "", err
+		}
+		entry.placed = true
+	}
+
+	return placeholderBlock(entry.id, cols, rows), nil
+}
+
+// attachmentIsRenderable reports whether an attachment is worth downloading.
+// Linear-hosted uploads carry no file extension, so they are probed and sorted
+// out by their content type; every other host must name an image in the path,
+// so opening an issue never reaches out to GitHub, Slack or the like.
+func attachmentIsRenderable(attachmentURL string) bool {
+	parsed, err := url.Parse(attachmentURL)
+	if err != nil || (parsed.Scheme != "http" && parsed.Scheme != "https") {
+		return false
+	}
+	if isLinearUploadHost(parsed.Host) {
+		return true
+	}
+
+	path := strings.ToLower(parsed.Path)
+	for _, ext := range imageURLExtensions {
+		if strings.HasSuffix(path, ext) {
+			return true
+		}
+	}
+	return false
+}
+
+// entry returns the tracked image for imageURL, creating it when unknown.
+func (r *imageRenderer) entry(imageURL string) (*kittyImage, bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	r.seq++
+	if entry, ok := r.images[imageURL]; ok {
+		entry.seq = r.seq
+		return entry, false
+	}
+
+	entry := &kittyImage{id: r.nextID, seq: r.seq}
+	r.nextID++
+	r.images[imageURL] = entry
+	r.evictLocked()
+	return entry, true
+}
+
+// evictLocked drops the least recently rendered images once the cache grows
+// past imageCacheEntries, releasing the terminal-side copies as well.
+func (r *imageRenderer) evictLocked() {
+	for len(r.images) > imageCacheEntries {
+		var oldestURL string
+		var oldest *kittyImage
+		for imageURL, entry := range r.images {
+			if oldest == nil || entry.seq < oldest.seq {
+				oldestURL, oldest = imageURL, entry
+			}
+		}
+		if oldest == nil {
+			return
+		}
+		r.deleteLocked(oldest)
+		delete(r.images, oldestURL)
+	}
+}
+
+// fetch downloads and decodes an image off the UI goroutine.
+func (r *imageRenderer) fetch(imageURL string, entry *kittyImage) {
+	img, err := r.download(imageURL)
+
+	r.mu.Lock()
+	if err != nil {
+		entry.state = imageFailed
+		entry.err = err
+		logger.Warning("tui.images: fetch failed url=%s error=%v", imageURL, err)
+	} else {
+		entry.state = imageReady
+		entry.src = img
+	}
+	r.mu.Unlock()
+
+	if r.notify != nil {
+		r.notify()
+	}
+}
+
+func (r *imageRenderer) download(imageURL string) (image.Image, error) {
+	parsed, err := url.Parse(imageURL)
+	if err != nil {
+		return nil, fmt.Errorf("invalid url: %w", err)
+	}
+	if parsed.Scheme != "http" && parsed.Scheme != "https" {
+		return nil, fmt.Errorf("unsupported scheme %q", parsed.Scheme)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), imageFetchTimeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, imageURL, nil)
+	if err != nil {
+		return nil, err
+	}
+	if r.token != "" && isLinearUploadHost(parsed.Host) {
+		if r.bearer {
+			req.Header.Set("Authorization", "Bearer "+r.token)
+		} else {
+			req.Header.Set("Authorization", r.token)
+		}
+	}
+
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("http %d", resp.StatusCode)
+	}
+	// Checked before the body is read so a video attachment costs its headers
+	// and nothing else. A missing or opaque type still goes to the decoder,
+	// which sniffs the actual bytes.
+	if mediaType, _, err := mime.ParseMediaType(resp.Header.Get("Content-Type")); err == nil &&
+		!strings.HasPrefix(mediaType, "image/") && mediaType != "application/octet-stream" {
+		return nil, fmt.Errorf("not an image (%s)", mediaType)
+	}
+
+	data, err := io.ReadAll(io.LimitReader(resp.Body, imageMaxDownloadSize+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > imageMaxDownloadSize {
+		return nil, errors.New("image too large")
+	}
+
+	img, _, err := image.Decode(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("decode: %w", err)
+	}
+	return img, nil
+}
+
+var imageURLExtensions = []string{".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp"}
+
+func isLinearUploadHost(host string) bool {
+	host = strings.ToLower(host)
+	return host == "linear.app" || strings.HasSuffix(host, ".linear.app")
+}
+
+// placementSize fits an image of w×h pixels into a cell box that keeps its
+// aspect ratio, bounded by the available columns and imageMaxCellRows.
+func placementSize(w, h, maxCols int) (cols, rows int) {
+	if w <= 0 || h <= 0 {
+		return 0, 0
+	}
+
+	cellW, cellH := cellPixelSize()
+	maxCols = min(maxCols, imageMaxCellCols)
+	if maxCols < 1 {
+		return 0, 0
+	}
+
+	cols = min(maxCols, (w+cellW-1)/cellW)
+	rows = (h*cols*cellW/w + cellH - 1) / cellH
+	if rows > imageMaxCellRows {
+		rows = imageMaxCellRows
+		cols = min(maxCols, max(1, w*rows*cellH/(h*cellW)))
+	}
+	return max(cols, 1), max(rows, 1)
+}
+
+func cellPixelSize() (int, int) {
+	w, h := terminalCellPixelSize()
+	if w <= 0 || h <= 0 {
+		return defaultCellPixelWidth, defaultCellPixelHeight
+	}
+	return w, h
+}
+
+// transmit sends the image data and (re)creates its virtual placement. The
+// escape codes neither move the cursor nor paint anything on their own, so
+// they are safe to emit between tcell frames.
+func (r *imageRenderer) transmit(entry *kittyImage) error {
+	cellW, cellH := cellPixelSize()
+	payload, err := encodePNG(entry.src, entry.cols*cellW, entry.rows*cellH)
+	if err != nil {
+		return err
+	}
+
+	encoded := base64.StdEncoding.EncodeToString(payload)
+	first := true
+	for len(encoded) > 0 {
+		size := min(imageChunkSize, len(encoded))
+		chunk := encoded[:size]
+		encoded = encoded[size:]
+
+		more := 0
+		if len(encoded) > 0 {
+			more = 1
+		}
+
+		header := fmt.Sprintf("m=%d", more)
+		if first {
+			header = fmt.Sprintf("a=T,U=1,q=2,f=100,t=d,i=%d,p=1,c=%d,r=%d,m=%d",
+				entry.id, entry.cols, entry.rows, more)
+			first = false
+		}
+		if err := r.writeSequence(fmt.Sprintf("\x1b_G%s;%s\x1b\\", header, chunk)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// writeSequence hands one graphics escape to the terminal. tmux drops APC
+// sequences it does not know, so inside it they travel in a DCS passthrough
+// with every embedded ESC doubled.
+func (r *imageRenderer) writeSequence(seq string) error {
+	if r.tmux {
+		seq = "\x1bPtmux;" + strings.ReplaceAll(seq, "\x1b", "\x1b\x1b") + "\x1b\\"
+	}
+	_, err := io.WriteString(r.out, seq)
+	return err
+}
+
+func (r *imageRenderer) deleteLocked(entry *kittyImage) {
+	if !entry.placed {
+		return
+	}
+	_ = r.writeSequence(fmt.Sprintf("\x1b_Ga=d,d=I,i=%d,q=2\x1b\\", entry.id))
+	entry.placed = false
+}
+
+// hasSupport reports whether image rendering is active for this session.
+func (r *imageRenderer) hasSupport() bool {
+	return r != nil && r.enabled
+}
+
+// hasPlacements reports whether anything is currently handed to the terminal,
+// which is what makes a re-layout worth the redraw.
+func (r *imageRenderer) hasPlacements() bool {
+	if r == nil || !r.enabled {
+		return false
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, entry := range r.images {
+		if entry.placed {
+			return true
+		}
+	}
+	return false
+}
+
+// close releases every image the terminal still holds for this session.
+func (r *imageRenderer) close() {
+	if r == nil || !r.enabled {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for _, entry := range r.images {
+		r.deleteLocked(entry)
+	}
+}
+
+// placeholderBlock builds the cells that make the terminal paint image id.
+// Every cell carries the image id in its foreground color plus the row and
+// column diacritics for the slice it shows.
+func placeholderBlock(id uint32, cols, rows int) string {
+	cols = min(cols, len(rowColumnDiacritics))
+	rows = min(rows, len(rowColumnDiacritics))
+
+	var b strings.Builder
+	b.Grow(rows * (cols*8 + 16))
+	for row := range rows {
+		fmt.Fprintf(&b, "[#%06x]", id&0xFFFFFF)
+		for col := range cols {
+			b.WriteRune(imagePlaceholderRune)
+			b.WriteRune(rowColumnDiacritics[row])
+			b.WriteRune(rowColumnDiacritics[col])
+		}
+		b.WriteString("[-]\n")
+	}
+	return b.String()
+}
+
+// indentLines prefixes every line of a placeholder block and drops its trailing
+// newline, so callers can treat the block as a single line of their layout.
+func indentLines(block, prefix string) string {
+	lines := strings.Split(strings.TrimSuffix(block, "\n"), "\n")
+	for i, line := range lines {
+		lines[i] = prefix + line
+	}
+	return strings.Join(lines, "\n")
+}
+
+func placeholderNotice(message, alt string) string {
+	if alt = strings.TrimSpace(alt); alt != "" {
+		return fmt.Sprintf("[::d]%s: %s[-:-:-]\n", alt, message)
+	}
+	return fmt.Sprintf("[::d]%s[-:-:-]\n", message)
+}
+
+// encodePNG scales src into a boxW×boxH canvas, keeping its aspect ratio, so
+// the terminal never has to resample and the payload stays small.
+func encodePNG(src image.Image, boxW, boxH int) ([]byte, error) {
+	if boxW <= 0 || boxH <= 0 {
+		return nil, errors.New("empty placement box")
+	}
+
+	canvas := image.NewNRGBA(image.Rect(0, 0, boxW, boxH))
+	drawScaled(canvas, src)
+
+	var buf bytes.Buffer
+	if err := png.Encode(&buf, canvas); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// drawScaled box-filters src into dst, centered and aspect-preserving.
+func drawScaled(dst *image.NRGBA, src image.Image) {
+	bounds := src.Bounds()
+	srcW, srcH := bounds.Dx(), bounds.Dy()
+	dstW, dstH := dst.Bounds().Dx(), dst.Bounds().Dy()
+
+	scale := min(float64(dstW)/float64(srcW), float64(dstH)/float64(srcH))
+	targetW := max(1, int(float64(srcW)*scale))
+	targetH := max(1, int(float64(srcH)*scale))
+	offsetX := (dstW - targetW) / 2
+	offsetY := (dstH - targetH) / 2
+
+	for y := range targetH {
+		y0 := bounds.Min.Y + y*srcH/targetH
+		y1 := max(y0+1, bounds.Min.Y+(y+1)*srcH/targetH)
+		for x := range targetW {
+			x0 := bounds.Min.X + x*srcW/targetW
+			x1 := max(x0+1, bounds.Min.X+(x+1)*srcW/targetW)
+			dst.SetNRGBA(offsetX+x, offsetY+y, averageColor(src, x0, y0, x1, y1))
+		}
+	}
+}
+
+func averageColor(src image.Image, x0, y0, x1, y1 int) color.NRGBA {
+	var r, g, b, a uint64
+	var count uint64
+	for y := y0; y < y1; y++ {
+		for x := x0; x < x1; x++ {
+			cr, cg, cb, ca := src.At(x, y).RGBA()
+			r += uint64(cr)
+			g += uint64(cg)
+			b += uint64(cb)
+			a += uint64(ca)
+			count++
+		}
+	}
+	if count == 0 {
+		return color.NRGBA{}
+	}
+	// RGBA() returns alpha-premultiplied 16-bit values; undo both.
+	alpha := a / count
+	if alpha == 0 {
+		return color.NRGBA{}
+	}
+	unpremultiply := func(v uint64) uint8 {
+		return uint8(min(v/count*0xFFFF/alpha, 0xFFFF) >> 8)
+	}
+	return color.NRGBA{
+		R: unpremultiply(r),
+		G: unpremultiply(g),
+		B: unpremultiply(b),
+		A: uint8(alpha >> 8),
+	}
+}
