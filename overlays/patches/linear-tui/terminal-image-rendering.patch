+package tui
+
+import (
+	"bytes"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gdamore/tcell/v2"
+	"github.com/rivo/tview"
+	"github.com/roeyazroel/linear-tui/internal/config"
+)
+
+func TestSplitMarkdownImagesKeepsDocumentOrder(t *testing.T) {
+	content := "intro\n\n![screenshot](https://uploads.linear.app/a.png)\n\noutro"
+
+	segments := splitMarkdownImages(content)
+	if len(segments) != 3 {
+		t.Fatalf("segments = %d, want 3", len(segments))
+	}
+	if segments[0].image || !strings.Contains(segments[0].text, "intro") {
+		t.Errorf("first segment = %+v, want intro text", segments[0])
+	}
+	if !segments[1].image || segments[1].url != "https://uploads.linear.app/a.png" || segments[1].alt != "screenshot" {
+		t.Errorf("second segment = %+v, want the image link", segments[1])
+	}
+	if segments[2].image || !strings.Contains(segments[2].text, "outro") {
+		t.Errorf("third segment = %+v, want outro text", segments[2])
+	}
+}
+
+func TestSplitMarkdownImagesWithoutImages(t *testing.T) {
+	segments := splitMarkdownImages("just [a link](https://example.com)")
+	if len(segments) != 1 || segments[0].image {
+		t.Fatalf("segments = %+v, want a single text segment", segments)
+	}
+}
+
+func TestPlaceholderBlockEncodesRowsAndColumns(t *testing.T) {
+	block := placeholderBlock(7, 2, 2)
+
+	lines := strings.Split(strings.TrimSuffix(block, "\n"), "\n")
+	if len(lines) != 2 {
+		t.Fatalf("lines = %d, want 2", len(lines))
+	}
+	for row, line := range lines {
+		if !strings.HasPrefix(line, "[#000007]") || !strings.HasSuffix(line, "[-]") {
+			t.Fatalf("line %d = %q, want the image id as foreground color", row, line)
+		}
+		cells := strings.TrimSuffix(strings.TrimPrefix(line, "[#000007]"), "[-]")
+		want := string([]rune{
+			imagePlaceholderRune, rowColumnDiacritics[row], rowColumnDiacritics[0],
+			imagePlaceholderRune, rowColumnDiacritics[row], rowColumnDiacritics[1],
+		})
+		if cells != want {
+			t.Errorf("row %d cells = %q, want %q", row, cells, want)
+		}
+	}
+}
+
+func TestPlacementSizeKeepsAspectWithinBudget(t *testing.T) {
+	cellW, cellH := cellPixelSize()
+
+	cols, rows := placementSize(cellW*10, cellH*5, 40)
+	if cols != 10 || rows != 5 {
+		t.Fatalf("cols, rows = %d, %d; want 10, 5", cols, rows)
+	}
+
+	cols, _ = placementSize(cellW*400, cellH*10, 30)
+	if cols != 30 {
+		t.Errorf("cols = %d, want the full column budget of 30", cols)
+	}
+
+	_, rows = placementSize(cellW*10, cellH*400, 30)
+	if rows > imageMaxCellRows {
+		t.Errorf("rows = %d, want at most %d", rows, imageMaxCellRows)
+	}
+}
+
+// TestPlaceholderCellsSurviveTviewDraw guards the assumption the whole feature
+// rests on: tview and tcell must hand the terminal the placeholder rune with
+// both diacritics and the exact 24-bit foreground color, or the terminal has
+// no way to tell which image slice a cell stands for.
+func TestPlaceholderCellsSurviveTviewDraw(t *testing.T) {
+	screen := tcell.NewSimulationScreen("UTF-8")
+	if err := screen.Init(); err != nil {
+		t.Fatal(err)
+	}
+	screen.SetSize(20, 5)
+
+	view := tview.NewTextView()
+	view.SetDynamicColors(true).SetWrap(false)
+	view.SetRect(0, 0, 20, 5)
+	view.SetText(placeholderBlock(7, 3, 2))
+	view.Draw(screen)
+	screen.Show()
+
+	cells, width, _ := screen.GetContents()
+	for row := range 2 {
+		for col := range 3 {
+			cell := cells[row*width+col]
+			if len(cell.Runes) != 3 || cell.Runes[0] != imagePlaceholderRune {
+				t.Errorf("cell (%d,%d) = %q, want placeholder plus two diacritics", row, col, cell.Runes)
+				continue
+			}
+			if cell.Runes[1] != rowColumnDiacritics[row] || cell.Runes[2] != rowColumnDiacritics[col] {
+				t.Errorf("cell (%d,%d) diacritics = %q, want row %d column %d", row, col, cell.Runes[1:], row, col)
+			}
+			if fg, _, _ := cell.Style.Decompose(); fg != tcell.NewHexColor(7) {
+				t.Errorf("cell (%d,%d) foreground = %v, want the image id", row, col, fg)
+			}
+		}
+	}
+}
+
+func TestAttachmentIsRenderable(t *testing.T) {
+	cases := map[string]bool{
+		"https://uploads.linear.app/c6161c13/1fc683fc-5a29": true,
+		"https://example.com/screenshot.PNG":                true,
+		"https://github.com/example/pull/1":                 false,
+		"https://example.com/recording.mp4":                 false,
+		"ftp://example.com/a.png":                           false,
+		"not a url":                                         false,
+	}
+	for attachmentURL, want := range cases {
+		if got := attachmentIsRenderable(attachmentURL); got != want {
+			t.Errorf("attachmentIsRenderable(%q) = %v, want %v", attachmentURL, got, want)
+		}
+	}
+}
+
+// TestDownloadRejectsNonImageContentType covers the Linear attachments that
+// carry no file extension: recordings and documents must be dropped on their
+// headers instead of being read into memory and failing to decode.
+func TestDownloadRejectsNonImageContentType(t *testing.T) {
+	var served bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "video/mp4")
+		w.WriteHeader(http.StatusOK)
+		served = true
+		_, _ = w.Write([]byte("not an image at all"))
+	}))
+	defer server.Close()
+
+	renderer := newImageRenderer(config.Config{}, nil)
+	if _, err := renderer.download(server.URL + "/attachment"); err == nil || !strings.Contains(err.Error(), "not an image") {
+		t.Fatalf("download error = %v, want a content type rejection", err)
+	}
+	if !served {
+		t.Fatal("handler never ran")
+	}
+}
+
+func TestIndentLinesKeepsBlockAsOneLayoutLine(t *testing.T) {
+	indented := indentLines(placeholderBlock(1, 2, 2), "  ")
+
+	if strings.HasSuffix(indented, "\n") {
+		t.Error("indented block still ends with a newline")
+	}
+	for _, line := range strings.Split(indented, "\n") {
+		if !strings.HasPrefix(line, "  [#") {
+			t.Errorf("line = %q, want the indent before the color tag", line)
+		}
+	}
+}
+
+// TestWriteSequenceWrapsForTmux pins the escaping that makes images survive a
+// multiplexer: tmux forwards an unknown sequence only inside a DCS
+// passthrough, and only when every ESC of the payload is doubled.
+func TestWriteSequenceWrapsForTmux(t *testing.T) {
+	const sequence = "\x1b_Ga=T,U=1;payload\x1b\\"
+
+	var direct bytes.Buffer
+	renderer := &imageRenderer{out: &direct}
+	if err := renderer.writeSequence(sequence); err != nil {
+		t.Fatal(err)
+	}
+	if direct.String() != sequence {
+		t.Errorf("outside tmux = %q, want the sequence untouched", direct.String())
+	}
+
+	var wrapped bytes.Buffer
+	renderer = &imageRenderer{out: &wrapped, tmux: true}
+	if err := renderer.writeSequence(sequence); err != nil {
+		t.Fatal(err)
+	}
+	want := "\x1bPtmux;\x1b\x1b_Ga=T,U=1;payload\x1b\x1b\\\x1b\\"
+	if wrapped.String() != want {
+		t.Errorf("inside tmux = %q, want %q", wrapped.String(), want)
+	}
+}
