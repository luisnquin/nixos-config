new file mode 100644
index 0000000..a55e73a
--- /dev/null
+++ b/internal/tui/kitty_cellsize_unix.go
@@ -0,0 +1,19 @@
+//go:build !windows
+
+package tui
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// terminalCellPixelSize returns the pixel size of a single cell as reported by
+// the terminal, or zeroes when it does not report pixel dimensions.
+func terminalCellPixelSize() (int, int) {
+	ws, err := unix.IoctlGetWinsize(int(os.Stdout.Fd()), unix.TIOCGWINSZ)
+	if err != nil || ws == nil || ws.Col == 0 || ws.Row == 0 {
+		return 0, 0
+	}
+	return int(ws.Xpixel) / int(ws.Col), int(ws.Ypixel) / int(ws.Row)
+}
