+// stateIcon maps a workflow state to its glyph and color. The list query only
+// carries the state name, so the name is what there is to match on, and any
+// state a workspace invents falls back to the unstarted circle.
+func stateIcon(state string, theme Theme) (string, tcell.Color) {
+	lowered := strings.ToLower(state)
+	switch {
+	case strings.Contains(lowered, "done"), strings.Contains(lowered, "complete"):
+		return StateIcons.Done, theme.StatusDone
+	case strings.Contains(lowered, "cancel"), strings.Contains(lowered, "duplicate"):
+		return StateIcons.Canceled, theme.SecondaryText
+	case strings.Contains(lowered, "review"):
+		return StateIcons.InReview, theme.StatusInProgress
+	case strings.Contains(lowered, "progress"), strings.Contains(lowered, "started"):
+		return StateIcons.InProgress, theme.StatusInProgress
+	case strings.Contains(lowered, "backlog"):
+		return StateIcons.Backlog, theme.SecondaryText
+	default:
+		return StateIcons.Todo, theme.StatusTodo
 	}
 }
 
