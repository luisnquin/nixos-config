+// TestStateIconDistinguishesWorkflowStages guards the substitution the tables
+// rely on: once the state name is gone, a stage that falls through to the same
+// glyph as another is indistinguishable on screen.
+func TestStateIconDistinguishesWorkflowStages(t *testing.T) {
+	stages := map[string]string{
+		"Backlog":     StateIcons.Backlog,
+		"Todo":        StateIcons.Todo,
+		"In Progress": StateIcons.InProgress,
+		"In Review":   StateIcons.InReview,
+		"Done":        StateIcons.Done,
+		"Canceled":    StateIcons.Canceled,
+		"Duplicate":   StateIcons.Canceled,
+		"Triage":      StateIcons.Todo,
+	}
+	for state, want := range stages {
+		if got, _ := stateIcon(state, LinearTheme); got != want {
+			t.Errorf("stateIcon(%q) = %q, want %q", state, got, want)
+		}
+	}
+
+	seen := map[string]string{}
+	for state, icon := range stages {
+		if state == "Duplicate" || state == "Triage" {
+			continue
+		}
+		if other, clash := seen[icon]; clash {
+			t.Errorf("states %q and %q share icon %q", state, other, icon)
+		}
+		seen[icon] = state
+	}
+}
+
+// TestPriorityIconRisesWithSeverity keeps the ramp monotonic: the glyphs are
+// only readable as severity if a higher priority never gets a shorter bar.
+func TestPriorityIconRisesWithSeverity(t *testing.T) {
+	ramp := []string{
+		PriorityIcons.None,
+		PriorityIcons.Low,
+		PriorityIcons.Normal,
+		PriorityIcons.High,
+		PriorityIcons.Urgent,
+	}
+	// Linear counts down from urgent, so severity order is 0, 4, 3, 2, 1.
+	for position, priority := range []int{0, 4, 3, 2, 1} {
+		got, _ := priorityIcon(priority, LinearTheme)
+		if got != ramp[position] {
+			t.Errorf("priorityIcon(%d) = %q, want %q", priority, got, ramp[position])
+		}
+	}
+	if urgent, _ := priorityIcon(1, LinearTheme); urgent != PriorityIcons.Urgent {
+		t.Errorf("urgent icon = %q, want %q", urgent, PriorityIcons.Urgent)
+	}
+}
