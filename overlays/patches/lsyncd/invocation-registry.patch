diff --git a/lsyncd.lua b/lsyncd.lua
--- a/lsyncd.lua
+++ b/lsyncd.lua
@@ -5709,6 +5709,116 @@
 --
 -- terminates on invalid arguments.
 --
+--
+-- Records every invocation in $XDG_STATE_HOME/lsyncd/<key>.reg so a status
+-- bar can list past syncs and relaunch them with the same argv and cwd.
+-- 'running' with a dead pid means the process died without a TERM or INT.
+--
+local registry = { version = 1 }
+
+local function registryQuote( s )
+	return "'" .. s:gsub( "'", "'\\''" ) .. "'"
+end
+
+local function registryTarget( config )
+	if config.host and config.targetdir
+	then
+		return config.host .. ':' .. config.targetdir
+	end
+
+	return tostring( config.target or '?' )
+end
+
+function registry.capture( args, config )
+	registry.cwd = lsyncd.getcwd( ) or '/'
+	registry.config = config
+	registry.args = { }
+
+	for i = 1, #args
+	do
+		registry.args[ i ] = args[ i ]
+	end
+end
+
+function registry.write( state )
+	if not registry.args then return end
+
+	local base = os.getenv( 'XDG_STATE_HOME' )
+
+	if not base or base == ''
+	then
+		local home = os.getenv( 'HOME' )
+
+		if not home or home == '' then return end
+
+		base = home .. '/.local/state'
+	end
+
+	local dir = base .. '/lsyncd'
+
+	if not registry.key
+	then
+		local seed = registry.config
+
+		if seed and seed:sub( 1, 1 ) ~= '/'
+		then
+			seed = registry.cwd .. '/' .. seed
+		end
+
+		if not seed
+		then
+			for _, s in Syncs.iwalk( )
+			do
+				seed = s.source .. '>' .. registryTarget( s.config )
+				break
+			end
+		end
+
+		seed = seed or 'unknown'
+
+		local hash = 5381
+
+		for i = 1, #seed
+		do
+			hash = ( hash * 33 + seed:byte( i ) ) % 4294967296
+		end
+
+		registry.key = seed:sub( -48 ):gsub( '[^%w%.%-]', '_' )
+			.. string.format( '-%08x', hash )
+	end
+
+	os.execute( 'mkdir -p ' .. registryQuote( dir ) )
+
+	local path = dir .. '/' .. registry.key .. '.reg'
+	local f = io.open( path .. '.tmp', 'w' )
+
+	if not f then return end
+
+	f:write( 'version=', registry.version, '\n' )
+	f:write( 'state=', state, '\n' )
+	f:write( 'pid=', lsyncd.getpid( ), '\n' )
+	f:write( 'updated=', os.time( ), '\n' )
+	f:write( 'cwd=', registry.cwd, '\n' )
+
+	if registry.config
+	then
+		f:write( 'config=', registry.config, '\n' )
+	end
+
+	for _, a in ipairs( registry.args )
+	do
+		f:write( 'arg=', a, '\n' )
+	end
+
+	for _, s in Syncs.iwalk( )
+	do
+		f:write( 'sync=', s.source, '\t', registryTarget( s.config ), '\n' )
+	end
+
+	f:close( )
+	os.rename( path .. '.tmp', path )
+end
+
