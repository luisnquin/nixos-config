+const char *cbm_app_data_dir(void) {
+#ifdef _WIN32
+    return cbm_app_local_dir();
+#else
+    static CBM_TLS char buf[CBM_SZ_1K];
+    char tmp[CBM_SZ_256] = "";
+    cbm_safe_getenv("XDG_DATA_HOME", tmp, sizeof(tmp), NULL);
+    if (tmp[0]) {
+        snprintf(buf, sizeof(buf), "%s", tmp);
+        return buf;
+    }
+    const char *home = cbm_get_home_dir();
+    if (home) {
+        snprintf(buf, sizeof(buf), "%s/.local/share", home);
+        return buf;
+    }
+    return NULL;
+#endif /* _WIN32 */
+}
