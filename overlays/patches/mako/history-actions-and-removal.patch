+static int handle_invoke_history_action(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct mako_state *state = data;
+	uint32_t id;
+	const char *action_key;
+	int ret = sd_bus_message_read(msg, "us", &id, &action_key);
+	if (ret < 0) {
+		return ret;
+	}
+
+	struct mako_notification *notif;
+	wl_list_for_each(notif, &state->history, link) {
+		if (notif->id != id) {
+			continue;
+		}
+
+		struct mako_action *action;
+		wl_list_for_each(action, &notif->actions, link) {
+			if (strcmp(action->key, action_key) == 0) {
+				notify_action_invoked(action, NULL);
+				break;
+			}
+		}
+		destroy_notification(notif);
+		emit_notifications_changed(state);
+		return sd_bus_reply_method_return(msg, "");
+	}
+
+	return sd_bus_error_set_errno(ret_error, ENOENT);
+}
