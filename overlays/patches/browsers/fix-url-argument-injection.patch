+// A launch target must never be parsable by the spawned browser as a CLI
+// flag; otherwise a URL like "--gpu-launcher=<cmd>" becomes argument
+// injection into the browser process. No legitimate URL or app scheme
+// starts with '-'.
+fn sanitize_launch_arg(app_url: String) -> String {
+    if app_url.trim_start().starts_with('-') {
+        warn!("Refusing to launch suspicious URL as argument: {app_url}");
+        return "about:blank".to_string();
+    }
+    return app_url;
+}
