 namespace {
 
+// switcheroo-control knows which GPU is discrete and which variables offload to it.
+QProcessEnvironment discreteGpuEnvironment() {
+  QProcessEnvironment env;
+  auto msg = QDBusMessage::createMethodCall("net.hadess.SwitcherooControl", "/net/hadess/SwitcherooControl",
+                                            "org.freedesktop.DBus.Properties", "Get");
+  msg << QString("net.hadess.SwitcherooControl") << QString("GPUs");
+
+  const QDBusReply<QDBusVariant> reply = QDBusConnection::systemBus().call(msg);
+
+  if (!reply.isValid()) {
+    qWarning() << "Unable to query switcheroo-control for the discrete GPU:" << reply.error().message();
+    return env;
+  }
+
+  const auto gpus = qdbus_cast<QList<QVariantMap>>(reply.value().variant());
+
+  for (const auto &gpu : gpus) {
+    if (gpu.value("Default").toBool()) continue;
+
+    const auto pairs = qdbus_cast<QStringList>(gpu.value("Environment"));
+
+    for (qsizetype i = 0; i + 1 < pairs.size(); i += 2) {
+      env.insert(pairs[i], pairs[i + 1]);
+    }
+
+    break;
+  }
+
+  return env;
+}
