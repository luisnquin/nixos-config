+/// the name share one row rather than the name taking a status-line slot.
+fn render_rail_thread_title(area: Rect, buf: &mut Buffer, title: &str) {
+    let title = title.trim();
+    if title.is_empty() {
+        return;
+    }
+
+    // The drawn cell is " <title> ", so the rail has to fit the two padding
+    // columns and the inset on top of whatever the title itself needs.
+    let reserved = RAIL_LABEL_RIGHT_INSET
+        .saturating_add(RAIL_LABEL_MIN_LEAD)
+        .saturating_add(2);
+    let Some(budget) = area.width.checked_sub(reserved).filter(|w| *w > 0) else {
+        return;
+    };
