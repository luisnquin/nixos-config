+const CONFIG_WRITES_ENABLED: bool = false;
+
+fn key_path_segments(key_path: &str) -> Option<Vec<String>> {
+    let document = format!("{key_path} = 0").parse::<DocumentMut>().ok()?;
+    let mut table = document.as_table();
+    let mut segments = Vec::new();
+    loop {
+        let (key, item) = table.iter().next()?;
+        segments.push(key.to_string());
+        match item {
+            TomlItem::Table(inner) => table = inner,
+            _ => return Some(segments),
+        }
+    }
+}
+
+fn json_to_toml_item(value: &JsonValue) -> Option<TomlItem> {
+    let mut wrapper = toml::Table::new();
+    wrapper.insert("v".to_string(), toml::Value::try_from(value).ok()?);
+    let document = toml::to_string(&wrapper).ok()?.parse::<DocumentMut>().ok()?;
+    document.get("v").cloned()
+}
+
+fn pending_config_edit(edit: &ConfigEdit) -> Option<CoreConfigEdit> {
+    let segments = key_path_segments(&edit.key_path)?;
+    if edit.value.is_null() {
+        return Some(CoreConfigEdit::ClearPath { segments });
+    }
+    let value = json_to_toml_item(&edit.value)?;
+    Some(CoreConfigEdit::SetPath { segments, value })
+}
+
+async fn record_pending_config_edits(config_path: &Path, edits: &[ConfigEdit]) {
+    let pending: Vec<CoreConfigEdit> = edits.iter().filter_map(pending_config_edit).collect();
+    if let Err(err) = ConfigEditsBuilder::for_config_path(config_path)
+        .with_edits(pending)
+        .apply()
+        .await
+    {
+        tracing::error!(error = %err, "failed to record pending config edits");
+    }
+}
+
