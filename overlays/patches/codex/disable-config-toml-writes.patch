+// Disabled: `config.toml` is a read-only symlink into the Nix store, so every
+// TUI-initiated `config/batchWrite` fails and surfaces a red error banner instead of
+// applying the setting. Reporting the write as applied keeps the change alive for the
+// session; durable changes belong in the home-manager module.
+const CONFIG_WRITES_ENABLED: bool = false;
+
+fn skipped_config_write_response() -> Result<ConfigWriteResponse> {
+    let file_path = find_codex_home()
+        .map(|codex_home| codex_home.join(CONFIG_TOML_FILE))
+        .wrap_err("failed to resolve CODEX_HOME")?;
+    Ok(ConfigWriteResponse {
+        status: WriteStatus::Ok,
+        version: String::new(),
+        file_path,
+        overridden_metadata: None,
+    })
+}
