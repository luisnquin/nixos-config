+    /// A dropped connection is ambiguous and earns the full `THREAD_UNLOADING_DELAY`; an explicit
+    /// `thread/unsubscribe` is the client saying it is done with the thread. Waiting 30 minutes to
+    /// act on that keeps the session - and its MCP child processes - alive long after the last
+    /// subscriber left, so collect it after a much shorter grace period instead.
+    ///
+    /// The idle sweep in `thread_lifecycle` still owns the general case; this only shortens the
+    /// deadline, and re-checks every precondition after sleeping so a resubscribe cancels it.
+    async fn schedule_unsubscribed_thread_unload(
+        &self,
+        thread_id: ThreadId,
+        thread: Arc<CodexThread>,
+    ) {
+        if self.thread_state_manager.has_subscribers(thread_id).await {
+            return;
+        }
+
+        let thread_manager = Arc::clone(&self.thread_manager);
+        let outgoing = Arc::clone(&self.outgoing);
+        let pending_thread_unloads = Arc::clone(&self.pending_thread_unloads);
+        let thread_state_manager = self.thread_state_manager.clone();
+        let thread_watch_manager = self.thread_watch_manager.clone();
+
+        tokio::spawn(async move {
+            tokio::time::sleep(super::thread_lifecycle::UNSUBSCRIBED_THREAD_UNLOADING_DELAY).await;
+
+            if thread_state_manager.has_subscribers(thread_id).await {
+                return;
+            }
+            if matches!(thread.agent_status().await, AgentStatus::Running) {
+                return;
+            }
+            // `agent_status` only reports the model loop. A thread parked on an approval or an
+            // input request is idle by that measure but still owns the user's turn, so mirror the
+            // liveness test the idle sweep uses before tearing anything down.
+            if matches!(
+                thread_watch_manager
+                    .loaded_status_for_thread(&thread_id.to_string())
+                    .await,
+                ThreadStatus::Active { .. }
+            ) {
+                return;
+            }
+            if thread_manager.get_thread(thread_id).await.is_err() {
+                return;
+            }
+            if !pending_thread_unloads.lock().await.insert(thread_id) {
+                return;
+            }
+
+            super::thread_lifecycle::unload_thread_without_subscribers(
+                thread_manager,
+                outgoing,
+                pending_thread_unloads,
+                thread_state_manager,
+                thread_watch_manager,
+                thread_id,
+                thread,
+            )
+            .await;
+        });
+    }
+
