+
+/// Pipes command output through the filter named by `CODEX_OUTPUT_REDACTOR`
+/// before the model sees it. Fails closed: output is withheld when the filter
+/// cannot run.
+pub(crate) fn redact_for_model(output: Vec<u8>) -> Vec<u8> {
+    use std::io::Write;
+    use std::process::Command;
+    use std::process::Stdio;
+
+    let Some(redactor) = std::env::var_os("CODEX_OUTPUT_REDACTOR") else {
+        return output;
+    };
+    if output.is_empty() {
+        return output;
+    }
+    let run = || -> std::io::Result<Vec<u8>> {
+        let mut child = Command::new(&redactor)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()?;
+        let mut stdin = child.stdin.take().expect("piped");
+        let writer = std::thread::spawn(move || stdin.write_all(&output));
+        let result = child.wait_with_output()?;
+        writer.join().map_err(|_| std::io::Error::other("writer panicked"))??;
+        if !result.status.success() {
+            return Err(std::io::Error::other(format!("exited with {}", result.status)));
+        }
+        Ok(result.stdout)
+    };
+    run().unwrap_or_else(|err| format!("[output withheld: redactor failed: {err}]").into_bytes())
+}
+
+pub(crate) fn redact_captured(
+    stream: crate::unified_exec::output::CapturedStream,
+) -> crate::unified_exec::output::CapturedStream {
+    let text = redact_for_model(stream.text.into_bytes());
+    crate::unified_exec::output::CapturedStream {
+        text: String::from_utf8_lossy(&text).into_owned(),
+        ..stream
     }
 }
