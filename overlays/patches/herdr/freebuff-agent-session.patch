@@ -0,0 +1,71 @@
+id = "freebuff"
+version = "2026.08.27.1"
+min_engine_version = 2
+updated_at = "2026-08-27T00:00:00Z"
+aliases = ["codebuff"]
+
+# freebuff never emits a state-bearing OSC title: `setTerminalTitle` writes
+# `Freebuff: <first words of the prompt>` once per submit and leaves it there.
+# Everything below reads the status bar and the input box, which render in that
+# order directly above the bottom of the screen.
+
+[[rules]]
+id = "ask_user_form_blocked"
+state = "blocked"
+priority = 1000
+region = "bottom_non_empty_lines(16)"
+visible_blocker = true
+# The ask_user form replaces the whole input box, so its hints cannot coexist
+# with the composer placeholder below.
+all = [
+  { contains = ["navigate"] },
+  { contains = ["enter select"] },
+]
+
+[[rules]]
+id = "gate_banner_blocked"
+state = "blocked"
+priority = 950
+region = "bottom_non_empty_lines(16)"
+visible_blocker = true
+any = [
+  { contains = ["press enter to continue"] },
+  { contains = ["press enter to buy more credits"] },
+  { contains = ["credit spending is disabled"] },
+  { contains = ["press enter to login"] },
+  { contains = ["open this url", "to login:"] },
+]
+
+[[rules]]
+id = "status_bar_working"
+state = "working"
+priority = 900
+region = "bottom_non_empty_lines(12)"
+visible_working = true
+any = [
+  { line_regex = ['(?i)(?:^|\s)thinking\.\.\.\s*$'] },
+  { line_regex = ['(?i)(?:^|\s)working\.\.\.\s*$'] },
+  { line_regex = ['(?i)(?:^|\s)connecting\.\.\.\s*$'] },
+  { line_regex = ['(?i)(?:^|\s)retrying\.\.\.\s*$'] },
+  { contains = ["in line, starting soon"] },
+]
+
+[[rules]]
+id = "stop_button_working"
+state = "working"
+priority = 880
+region = "bottom_non_empty_lines(12)"
+visible_working = true
+# The status bar only mounts this button while waiting or streaming.
+contains = ["■ esc"]
+
+[[rules]]
+id = "composer_idle"
+state = "idle"
+priority = 100
+region = "bottom_non_empty_lines(8)"
+visible_idle = true
+any = [
+  { contains = ["enter a coding task"] },
+  { contains = ["ctrl-c to cancel queued messages"] },
+]
