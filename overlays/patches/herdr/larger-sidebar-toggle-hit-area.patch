+/// A one-cell icon is not a target a finger can land on over ssh from a phone.
+/// The icon keeps its cell; only the press area grows, leftwards and upwards so
+/// the divider column stays draggable down to its last row.
+const SIDEBAR_TOGGLE_HIT_WIDTH: u16 = 8;
+const SIDEBAR_TOGGLE_HIT_HEIGHT: u16 = 2;
+
+fn toggle_hit_rect(area: Rect, icon: Rect, width: u16) -> Rect {
+    if icon == Rect::default() {
+        return Rect::default();
+    }
+    let height = SIDEBAR_TOGGLE_HIT_HEIGHT.min(area.height);
+    let right = icon.x + icon.width;
+    let x = right.saturating_sub(width).max(area.x);
+    let y = (icon.y + icon.height).saturating_sub(height).max(area.y);
+    Rect::new(x, y, right.saturating_sub(x), height)
+}
+
+pub(crate) fn collapsed_sidebar_toggle_hit_rect(area: Rect) -> Rect {
+    // The collapsed strip is four columns wide, so the icon takes the whole
+    // content row rather than the eight columns it cannot have.
+    let icon = collapsed_sidebar_toggle_rect(area);
+    let content_w = area.width.saturating_sub(1);
+    let right_pad = content_w.saturating_sub(icon.x.saturating_sub(area.x) + icon.width);
+    toggle_hit_rect(
+        area,
+        Rect {
+            width: icon.width + right_pad,
+            ..icon
+        },
+        content_w,
+    )
+}
+
+pub(crate) fn expanded_sidebar_toggle_hit_rect(area: Rect) -> Rect {
+    toggle_hit_rect(
+        area,
+        expanded_sidebar_toggle_rect(area),
+        SIDEBAR_TOGGLE_HIT_WIDTH,
+    )
+}
